// See docs/ARCHITECTURE.md for why the data model looks like this
// (in particular: why there's no separate "DM" vs "group" table).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  // Public, unique identifier used to find someone. Display names are not
  // unique — two people called "Minh" are indistinguishable in search results —
  // and email is deliberately never returned by search, so without a handle
  // there is no safe way to tell two accounts apart.
  // Always stored lowercase: Postgres unique indexes are case-sensitive, so
  // normalising on write is what makes "Minh" and "minh" the same handle.
  handle            String    @unique
  passwordHash      String
  displayName       String
  // When the avatar was last replaced — null means there is no picture.
  //
  // Not a URL. The file lives under one key derived from the user id, and the
  // URL the client gets is built from this timestamp
  // (`/users/:id/avatar?v=<ms>`). Storing the URL instead would mean either
  // rewriting every row to move the files to S3, or keeping the old picture
  // cached in browsers after an upload — the same reason Mattermost stores
  // `last_picture_update` and Rocket.Chat an avatar etag.
  avatarUpdatedAt   DateTime?
  /// When the password was last replaced, or null if it never has been.
  ///
  /// Read by `requireAuth` and by the socket handshake on every request: a JWT
  /// issued before this moment is refused. Without it, changing or resetting a
  /// password would leave every session opened beforehand working until the
  /// token expired — which is exactly the case a reset is reached for.
  passwordChangedAt DateTime?
  createdAt         DateTime  @default(now())

  participants        ConversationParticipant[]
  messages            Message[]
  passwordResetTokens PasswordResetToken[]
}

/// A one-time link mailed to someone who cannot sign in.
///
/// The token itself is never stored — only a SHA-256 of it, the same reasoning
/// that keeps `passwordHash` out of `User.password`: a leaked database must not
/// hand over working credentials. SHA-256 rather than bcrypt because the value
/// being hashed is 32 bytes of `crypto.randomBytes`, and a slow hash defends
/// against guessing that is already impossible.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  /// Set the moment the token is redeemed. A used token is kept rather than
  /// deleted so that a second attempt can be told apart from a made-up one in
  /// the logs — both still answer the same thing to the caller.
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Where an outbox message is in its life.
///
/// Three values, and only one of them means "there is still work here": the
/// worker claims PENDING rows and nothing else ever moves back into it. SENT and
/// FAILED are both terminal, and both redact the body — see the model below.
enum OutboxStatus {
  PENDING
  SENT
  FAILED
}

/// An email this app has promised to send but has not sent yet.
///
/// A transactional outbox. The row is written **inside the same transaction as
/// the thing that caused it** — for a password reset, the same transaction that
/// creates the token — so "this link is live" and "we owe this person the link"
/// commit or roll back together. Before this table the send was fired after the
/// commit and forgotten: a crash in that window, or a provider having a bad
/// minute, lost the mail with nothing left to say it had ever been owed.
///
/// It is not a general job queue and should not become one. Everything here is
/// shaped by mail: a recipient, a rendered body, and the fact that sending twice
/// is worse than sending late.
model OutboxMessage {
  id      String       @id @default(cuid())
  status  OutboxStatus @default(PENDING)
  to      String
  subject String
  /// The rendered message, and **emptied the moment there is nothing left to
  /// send** — on success and on final failure alike.
  ///
  /// This is the one uncomfortable part of an outbox for password reset: the
  /// body contains the live link, so between commit and delivery a working key
  /// to an account sits in a table in plaintext. There is no way around holding
  /// it — the mail cannot be sent without it — so the mitigations are that the
  /// window is one poll interval rather than an hour, that the token's own TTL
  /// bounds the worst case, and that the check constraint below makes the
  /// redaction a property of the data rather than a habit of the worker. Same
  /// argument, and the same shape, as `Message.deletedAt`.
  body    String
  /// How many times delivery has been tried. Attempt zero is a row nobody has
  /// picked up yet, not a row that failed once.
  attempts      Int      @default(0)
  /// The earliest the worker may try again — now for a new row, then pushed out
  /// by exponential backoff after each failure. Also what makes a claim query
  /// cheap: due rows are an index range rather than a scan.
  ///
  /// `dbgenerated`, not `now()`, and the difference is a bug rather than a
  /// preference. Prisma evaluates `@default(now())` in the client, using the
  /// application's clock, while the worker's claim compares this column against
  /// PostgreSQL's `NOW()`. Two clocks. A machine a few milliseconds ahead of the
  /// database writes a row that is not yet due the instant it is created, and on
  /// a real deployment — app and database on different hosts — the skew is not
  /// milliseconds. It showed up here as a test suite that passed four times in
  /// five; it would have shipped as mail that sometimes just sits there.
  ///
  /// Everything that is *compared* against the database clock is therefore
  /// written by the database. `createdAt` and `sentAt` are only ever read by
  /// people, so they stay ordinary.
  nextAttemptAt DateTime @default(dbgenerated("CURRENT_TIMESTAMP"))
  /// Why the last attempt failed, kept for the person reading the table at 3am.
  /// Never contains the body, so it is safe to log and to keep after redaction.
  lastError     String?
  sentAt        DateTime?
  createdAt     DateTime  @default(now())

  // The worker's only query: due PENDING rows, oldest first. Ordering the index
  // this way means it serves both the filter and the sort.
  @@index([status, nextAttemptAt])
}

model Conversation {
  id        String   @id @default(cuid())
  // true once a third participant joins; kept explicit rather than derived
  // from participant count so a 1-1 chat that later becomes a group doesn't
  // silently change identity.
  isGroup   Boolean  @default(false)
  // display name for group chats; null for 1-1 (client derives a name from
  // the other participant)
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  participants ConversationParticipant[]
  messages     Message[]
}

/// Who may kick and rename inside a group.
///
/// Two values, not a permission matrix: the only distinction the app makes is
/// "may act on other people" versus "may act on yourself". Adding a member is
/// deliberately not gated by it — see ADR 0008.
enum ConversationRole {
  OWNER
  MEMBER
}

model ConversationParticipant {
  id                String           @id @default(cuid())
  conversationId    String
  userId            String
  /// Every group has exactly one OWNER while it has anyone in it: the creator
  /// to begin with, and on their way out the longest-standing member left (see
  /// `removeParticipant`). Meaningless in a direct conversation, where there is
  /// nothing to administer — both rows there stay MEMBER.
  ///
  /// PostgreSQL enforces the cross-row rule Prisma cannot express: the phase 7
  /// migration adds an OWNER-only unique index plus a deferred constraint
  /// trigger, so a non-empty group has exactly one owner at commit time.
  role              ConversationRole @default(MEMBER)
  joinedAt          DateTime         @default(now())
  // Newest message this participant has read. Per-participant, so it belongs
  // here and not on Message: "read" is a fact about a person, and a group of
  // ten has ten different answers for the same message.
  //
  // A plain column rather than a relation with a foreign key: SetNull on delete
  // would silently reset someone's marker to "nothing read" the first time a
  // message is deleted, which reads as a whole conversation going unread.
  lastReadMessageId String?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
}

/// Who wrote a message — a person, or the app itself.
///
/// The discriminator for `Message.authorId` being nullable. Reading "authorId
/// is null" as "system" would work today and break the first time a message
/// outlives its author, which is precisely what a deleted account produces.
enum MessageKind {
  USER
  SYSTEM
}

model Message {
  id             String      @id @default(cuid())
  conversationId String
  /// Null only on a SYSTEM message, which nobody wrote.
  /// Enforced together with `kind` by the phase 7 database check constraint.
  authorId       String?
  kind           MessageKind @default(USER)
  // Empty string for a message that is only an image. Nullable would be more
  // truthful, but every read of this column would then need a null branch to
  // save one for the write — and "no caption" and "empty caption" are the same
  // thing to a reader.
  //
  // On a SYSTEM message this holds the sentence itself, already rendered
  // ("An added Binh"). The names in it are a snapshot of who people were when
  // it happened, deliberately — see ADR 0009.
  content        String
  createdAt      DateTime    @default(now())
  /// When the author last replaced `content`, or null if they never have.
  ///
  /// A timestamp rather than a boolean because the UI eventually wants to say
  /// *when*, and because "edited" is derivable from it while the reverse is not.
  editedAt       DateTime?
  /// When the author deleted this message, or null while it stands.
  ///
  /// A tombstone, not a `DELETE`. Two things in this schema point at a message
  /// id without a foreign key to protect them, and both break if the row goes:
  ///
  /// - `ConversationParticipant.lastReadMessageId` is a plain column on purpose
  ///   (see its comment). The unread query LEFT JOINs the marker and reads a
  ///   miss as "nothing read yet", so hard-deleting the newest message would
  ///   relight the badge on the *entire* history for everyone who had read it.
  /// - Message paging passes the oldest loaded id back as a Prisma cursor. A
  ///   cursor row that no longer exists fails the request for the next page.
  ///
  /// `content` is emptied in the same write, and the check constraint below
  /// makes that the database's rule rather than the service's promise — a
  /// deleted message must not still be carrying its text.
  deletedAt      DateTime?
  /// What search matches against: `to_tsvector('simple', content)`, maintained
  /// by PostgreSQL as a GENERATED column.
  ///
  /// `Unsupported` because Prisma has no tsvector type, and that is fine here —
  /// Prisma leaves such fields out of the generated client entirely, which is
  /// exactly the behaviour a generated column needs. Nothing may write to it,
  /// and nothing can: search reads it through raw SQL.
  ///
  /// Declared at all only so `prisma db pull` and a future `migrate dev` do not
  /// see the column as drift and offer to drop it.
  searchVector   Unsupported("tsvector")?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  author       User?        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  attachment   Attachment?

  @@index([conversationId, createdAt])
  // The GIN index on `searchVector` lives in the phase 12 migration: Prisma
  // cannot express an index method, and an `@@index` here would create a second,
  // useless btree one alongside it.
}

/// An image sent with a message.
///
/// One per message, enforced by the unique on `messageId`. Several would need a
/// gallery in the message list and a decision about what a mixed
/// caption-plus-many-images looks like; dropping the unique later relaxes this
/// without moving any data, whereas going the other way would not.
///
/// There is no mime type or original filename column. Every upload is decoded
/// and re-encoded to WebP before anything is written (lib/attachment-storage.ts),
/// so the type is known and constant, and the name the uploader chose is a
/// string from a stranger that nothing here needs.
model Attachment {
  id        String   @id @default(cuid())
  messageId String   @unique
  // Stored so the message list can reserve the right space before the image
  // has loaded. Without them every arriving picture shoves the conversation
  // around as it decodes.
  width     Int
  height    Int
  byteSize  Int
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
}
