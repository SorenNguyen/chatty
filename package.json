{
	"name": "chatty",
	"private": true,
	"version": "0.1.0",
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"engines": {
		"node": ">=22.22.2"
	},
	"scripts": {
		"audit:rules": "node scripts/run-audit.mjs",
		"build": "npm run build --workspaces --if-present",
		"db:down": "docker compose down",
		"db:up": "docker compose up -d postgres",
		"dev:server": "npm run dev --workspace apps/server",
		"dev:web": "npm run dev --workspace apps/web",
		"e2e:install": "playwright install chromium",
		"format": "prettier --write .",
		"format:check": "prettier --check . --end-of-line auto",
		"lint": "eslint .",
		"test": "npm run test --workspaces --if-present",
		"test:e2e": "playwright test",
		"typecheck": "npm run typecheck --workspaces --if-present && npm run typecheck:e2e",
		"typecheck:e2e": "tsc -p tsconfig.e2e.json",
		"verify": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run verify:audit",
		"verify:audit": "node scripts/run-audit.mjs --gate"
	},
	"devDependencies": {
		"@eslint/js": "^9.15.0",
		"@playwright/test": "^1.62.1",
		"eslint": "^9.15.0",
		"eslint-config-prettier": "^9.1.0",
		"prettier": "^3.3.3",
		"typescript": "^5.6.3",
		"typescript-eslint": "^8.14.0"
	}
}
