# Copy this file to apps/server/.env and fill in real values for local dev.

# Postgres connection string used by Prisma
DATABASE_URL="postgresql://chatty:chatty@localhost:5432/chatty"

# Secret used to sign JWTs. Generate a real random value for anything beyond local dev.
JWT_SECRET="dev-secret-change-me"

# Port the API + WebSocket server listens on
PORT=4000

# Origin allowed to call the API / connect the socket (the web app's dev URL)
CORS_ORIGIN="http://localhost:5173"

# How this API is reachable from a browser. Avatar URLs are built from it and go
# into an <img src> on the web app's origin, so a relative path would resolve
# against Vite (:5173) instead of this server.
PUBLIC_URL="http://localhost:4000"

# Where uploaded files are written. Relative paths resolve against apps/server,
# so this sits beside the Postgres volume in .data/ and is gitignored with it.
UPLOAD_DIR=".data/uploads"

# How mail leaves the process. Required, and there is no default — a deployment
# that forgets this does not start, which is the point. Two values:
#
#   console  writes the message to the server log instead of sending it. Fine for
#            a quick local run; refused outright when NODE_ENV=production, because
#            every password reset link would go to stdout.
#   smtp     actually sends, using SMTP_URL and MAIL_FROM below. Setting this
#            without them also fails to start, rather than falling back quietly.
#
# For local development prefer `smtp` against Mailpit — `docker compose up -d
# mailpit` gives you a real SMTP server on :1025 and a web inbox on :8025, so you
# read the reset mail the way a user would instead of grepping a log.
MAIL_TRANSPORT="smtp"

# The SMTP server, as one URL. Mailpit accepts any credentials; a real provider
# (Resend, Postmark, SendGrid, SES, a company relay) gives you this string in its
# dashboard. Use smtps:// for implicit TLS on port 465.
SMTP_URL="smtp://chatty:chatty@localhost:1025"

# The From: address. Providers reject senders on unverified domains, so in
# production this has to be one you own.
MAIL_FROM="no-reply@chatty.test"

# Where Redis is, if there is one. Optional: leave it unset and rate-limit
# counters and Socket.io rooms stay in this process's memory, which is correct
# for a single instance and wrong for two. `npm run db:up` does not start Redis;
# `docker compose up -d redis` does. docker-compose.prod.yml always sets it.
# REDIS_URL="redis://localhost:6379"
