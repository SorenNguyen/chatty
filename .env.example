# Copy this file to apps/server/.env and fill in real values for local dev.

# Postgres connection string used by Prisma
DATABASE_URL="postgresql://chatty:chatty@localhost:5432/chatty"

# Secret used to sign JWTs. Generate a real random value for anything beyond local dev.
JWT_SECRET="dev-secret-change-me"

# Port the API + WebSocket server listens on
PORT=4000

# Origin allowed to call the API / connect the socket (the web app's dev URL)
CORS_ORIGIN="http://localhost:5173"

# How this API is reachable from a browser. Avatar URLs are built from it and go
# into an <img src> on the web app's origin, so a relative path would resolve
# against Vite (:5173) instead of this server.
PUBLIC_URL="http://localhost:4000"

# Where uploaded files are written. Relative paths resolve against apps/server,
# so this sits beside the Postgres volume in .data/ and is gitignored with it.
UPLOAD_DIR=".data/uploads"
